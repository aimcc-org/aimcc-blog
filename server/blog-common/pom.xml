<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aimcc</groupId>
        <artifactId>server-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>blog-common</artifactId>
    <name>blog-common</name>
    <description>两个服务共用的无业务含义的公共件：统一返回体、业务异常</description>

    <dependencies>
        <!-- ApiResult / BizException / ErrorCode 都用 Lombok 生成 getter -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 全局异常处理器要用的 Web 注解与异常类型。
             用 provided 而不是 starter-webmvc：provided 只在本模块编译期可见、不传递给下游，
             网关（WebFlux）依赖本模块时不会被塞进 Spring MVC，避免两者在同一 classpath 冲突 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- spring-webmvc 里的异常类继承自 ServletException，provided 作用域不会带出它的传递依赖，
             所以这里要单独补一份 Servlet API（同样 provided，不进最终镜像） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- @Slf4j 需要 slf4j API；运行时日志实现由各服务的 starter 提供，这里只要编译期可见 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- NotLoginException 的类型来源：异常处理器要接住 Sa-Token 抛的未登录异常。
             它是个纯 Java 核心包，不带 Spring；public 虽然不抛这个异常，但类必须能加载 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
    </dependencies>

    <!-- 刻意不依赖 spring-boot-starter-webmvc：
         以后网关模块（WebFlux）要能依赖本模块，而 WebMVC 与 WebFlux 不能共存于同一个 classpath -->
</project>
