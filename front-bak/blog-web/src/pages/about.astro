---
import { render } from 'astro:content';
import { currentProfile } from '@/config/build-profile';
import { getProfilePage } from '@/content/posts';
import BaseLayout from '@/layouts/base/BaseLayout.astro';

const entry = await getProfilePage('about');
if (!entry) throw new Error(`Missing about page for profile ${currentProfile.id}`);
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class="shell" style="padding:40px 0 80px;">
    <article class="card prose" style="padding:32px;">
      <h1>{entry.data.title}</h1>
      <Content />
    </article>
  </main>
</BaseLayout>
