---
import type { PostSummary } from "@/types/post";

interface Props {
  post: PostSummary;
  index: number;
}

const { post, index } = Astro.props;
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date(post.publishedAt));
const stats = [
  post.wordCount ? `${post.wordCount.toLocaleString()} 字` : null,
  post.readingTime ? `阅读约 ${post.readingTime} 分钟` : null,
]
  .filter(Boolean)
  .join(" | ");
---

<article
  class="post-card"
  style={`--stagger-index:${index}`}
  data-tags={post.tags.join("|")}
>
  <a
    class:list={["post-card__link", { "is-featured": index === 0 }]}
    href={`/posts/${post.slug}/`}
  >
    <div class="post-card__cover">
      <img
        src={post.cover ?? "/images/ai-workflow-city.png"}
        alt=""
        loading={index === 0 ? "eager" : "lazy"}
      />
      <span class="post-card__cover-label">观察 · 构建 · 复盘</span>
    </div>
    <div class="post-card__body">
      <h2>{post.title}</h2>
      <div class="post-card__meta">
        <time datetime={post.publishedAt}>{date}</time>
        {post.category && <span>{post.category}</span>}
        {post.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
      </div>
      {post.description && <p>{post.description}</p>}
      <div class="post-card__footer">
        <span>{stats}</span>
        {
          (
            <span class="post-card__arrow" aria-hidden="true">
              →
            </span>
          )
        }
      </div>
    </div>
  </a>
</article>
