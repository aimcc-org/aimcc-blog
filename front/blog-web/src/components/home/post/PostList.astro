---
import type { PostSummary } from "@/types/post";
import TagArticleResults from "@/components/islands/TagArticleResults";

interface Props {
  posts: PostSummary[];
}
---

<section
  id="posts"
  class="home-posts"
  aria-label="文章列表"
  transition:name="home-content"
  transition:animate="fade"
>
  <header class="home-posts__intro">
    <div>
      <span class="eyebrow"><i></i> AI 研究札记</span>
      <h1>记录正在发生的<br /><em>智能协作实验</em></h1>
    </div>
    <p>
      从工具到工作流，从模型评估到人与 AI
      的协作方式。这里保存实践中的判断、方法和仍待回答的问题。
    </p>
  </header>
  <TagArticleResults client:load />
</section>
