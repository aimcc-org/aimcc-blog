---
import type { PostSummary } from "@/types/post";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";

interface Props {
  posts: PostSummary[];
}

const { posts } = Astro.props;
---

<section
  id="posts"
  class="home-posts"
  aria-label="文章列表"
  transition:name="home-content"
  transition:animate="slide"
>
  <div class="home-posts__list">
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </div>
  <p class="home-posts__empty" hidden>当前标签下暂无文章。</p>
  <Pagination current={1} total={1} />
</section>

<script>
  const params = new URLSearchParams(window.location.search);
  const activeTag = params.get("tag")?.toLowerCase();
  const postCards = [...document.querySelectorAll<HTMLElement>(".post-card")];
  const empty = document.querySelector<HTMLElement>(".home-posts__empty");

  if (activeTag) {
    let visibleCount = 0;

    for (const card of postCards) {
      const tags = (card.dataset.tags ?? "")
        .split("|")
        .map((tag) => tag.toLowerCase());
      const visible = tags.includes(activeTag);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (empty) empty.hidden = visibleCount > 0;
  }
</script>
