---
import type { PostSummary } from "@/types/post";
import PostCard from "./PostCard.astro";

interface Props {
  posts: PostSummary[];
}

const { posts } = Astro.props;
---

<section
  id="posts"
  class="home-posts"
  aria-label="文章列表"
  transition:name="home-content"
  transition:animate="fade"
>
  <header class="home-posts__intro">
    <div>
      <span class="eyebrow"><i></i> AI 研究札记</span>
      <h1>记录正在发生的<br /><em>智能协作实验</em></h1>
    </div>
    <p>
      从工具到工作流，从模型评估到人与 AI
      的协作方式。这里保存实践中的判断、方法和仍待回答的问题。
    </p>
  </header>
  <div class="home-posts__list">
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </div>
  <p class="home-posts__empty" hidden>当前标签下暂无文章。</p>
</section>

<script>
  const params = new URLSearchParams(window.location.search);
  const activeTag = params.get("tag")?.toLowerCase();
  const activeCategory = params.get("category")?.toLowerCase();
  const postCards = [...document.querySelectorAll<HTMLElement>(".post-card")];
  const empty = document.querySelector<HTMLElement>(".home-posts__empty");

  if (activeTag || activeCategory) {
    let visibleCount = 0;

    for (const card of postCards) {
      const tags = (card.dataset.tags ?? "")
        .split("|")
        .map((tag) => tag.toLowerCase());
      const category = (card.dataset.category ?? "").toLowerCase();
      const visible =
        (!activeTag || tags.includes(activeTag)) &&
        (!activeCategory || category === activeCategory);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (empty) empty.hidden = visibleCount > 0;
  }
</script>
