---
interface TagItem {
  id?: number;
  name: string;
  count?: number;
  href?: string;
}

interface Props {
  tags: TagItem[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <section class="home-card taxonomy-card" aria-labelledby="tags-title">
      <h2 id="tags-title">Tags</h2>
      <div class="tag-cloud">
        {tags.map((item) => (
          <a
            class="tag-cloud__item"
            href={item.href ?? `/?tag=${encodeURIComponent(item.name)}#posts`}
            data-tag-id={item.id}
          >
            #{item.name}
            {item.count ? <span>{item.count}</span> : null}
          </a>
        ))}
      </div>
    </section>
  )
}
