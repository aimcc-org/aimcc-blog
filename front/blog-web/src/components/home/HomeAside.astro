---
import { getPersonalProfile } from "@/lib/profile";
const profile = await getPersonalProfile();
---

<aside class="home-aside" aria-label="实验室与快捷入口">
  <section class="home-aside__panel">
    <span class="eyebrow">NOW / 当前在做</span>
    <h2>AIMCC<br />AI LAB.</h2>
    {
      profile.now && (
        <>
          <>
            <p>{profile.now.description}</p>
            <ul>
              {profile.now.activities.map((activity) => (
                <li>{activity}</li>
              ))}
            </ul>
          </>
        </>
      )
    }
  </section>
  <nav class="home-aside__panel home-aside__links" aria-label="快捷入口">
    <span class="eyebrow">QUICK LINKS</span>
    {
      profile.resumeUrl && (
        <a href={profile.resumeUrl}>
          电子简历 <span aria-hidden="true">↗</span>
        </a>
      )
    }
    {
      profile.githubUrl && (
        <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      )
    }
    <a href="/about/">关于我 <span aria-hidden="true">→</span></a>
    <a href="/archive/">文章归档 <span aria-hidden="true">→</span></a>
  </nav>
  <div class="home-aside__ambient" aria-hidden="true">
    <span>IDEAS<br />TO<br />PRODUCTS.</span><img
      src="/images/ai-workflow-city.png"
      alt=""
      loading="lazy"
    />
  </div>
</aside>
