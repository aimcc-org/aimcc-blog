---
import { getPersonalProfile } from "@/lib/profile";
import { NowCard, QuickLinks, AmbientCard } from "@aimcc/react-component";
import type { QuickLink } from "@aimcc/react-component";
const profile = await getPersonalProfile();
const links: QuickLink[] = [
  ...(profile.resumeUrl
    ? [{ label: "电子简历", href: profile.resumeUrl }]
    : []),
  ...(profile.githubUrl
    ? [{ label: "GitHub", href: profile.githubUrl, external: true }]
    : []),
  { label: "关于我", href: "/about/" },
  { label: "文章归档", href: "/archive/" },
];
---

<aside class="home-aside" aria-label="实验室与快捷入口">
  <NowCard
    title={"AIMCC\nAI LAB."}
    description={profile.now?.description}
    activities={profile.now?.activities}
  />
  <QuickLinks title="QUICK LINKS" links={links} />
  <AmbientCard
    image="/images/ai-workflow-city.png"
    slogan={"IDEAS\nTO\nPRODUCTS."}
  />
</aside>
