---
import type { PostSummary } from "@/types/post";

interface Props {
  posts: PostSummary[];
  activeSlug?: string;
}

const { posts, activeSlug } = Astro.props;
const groups = [
  ...posts.reduce((map, post) => {
    const category = post.category || "未分类";
    const items = map.get(category) ?? [];
    items.push(post);
    map.set(category, items);
    return map;
  }, new Map<string, PostSummary[]>()),
].map(([name, items]) => ({
  name,
  items,
  containsActive: items.some((post) => post.slug === activeSlug),
}));
---

<aside class="article-index" aria-label="分类文章索引">
  <header class="article-index__header">
    <div>
      <span>INDEX</span>
      <strong>文章索引</strong>
    </div>
    <span class="article-index__count"
      >{String(posts.length).padStart(2, "0")}</span
    >
  </header>

  <nav class="article-index__categories" aria-label="文章分类">
    {
      groups.map((group) => (
        <details
          class="article-index__group"
          open={group.containsActive || !activeSlug}
        >
          <summary>
            <span>{group.name}</span>
            <span>{String(group.items.length).padStart(2, "0")}</span>
          </summary>
          <div class="article-index__list">
            <a
              class="article-index__filter"
              href={`/?category=${encodeURIComponent(group.name)}#posts`}
            >
              查看此分类 <span aria-hidden="true">→</span>
            </a>
            {group.items.map((post) => {
              const index = posts.findIndex((item) => item.slug === post.slug);
              const issue = String(posts.length - index).padStart(3, "0");
              const isActive = post.slug === activeSlug;

              return (
                <a
                  class:list={[
                    "article-index__item",
                    { "is-active": isActive },
                  ]}
                  href={`/posts/${post.slug}/`}
                  aria-current={isActive ? "page" : undefined}
                >
                  <span class="article-index__issue">
                    <i aria-hidden="true" />
                    {issue}
                  </span>
                  <span class="article-index__title">{post.title}</span>
                </a>
              );
            })}
          </div>
        </details>
      ))
    }
  </nav>

  <footer class="article-index__footer">
    <a href="/#posts">全部文章</a>
    <a href="/archive/">归档 <span aria-hidden="true">→</span></a>
  </footer>
</aside>
