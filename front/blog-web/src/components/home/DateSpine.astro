---
import type { PostSummary } from "@/types/post";

interface Props {
  post?: PostSummary;
}

const { post } = Astro.props;
const published = post ? new Date(post.publishedAt) : new Date();
const year = published.getFullYear();
const month = new Intl.DateTimeFormat("zh-CN", { month: "long" }).format(
  published,
);
const day = String(published.getDate()).padStart(3, "0");
---

<aside class="date-spine" aria-label="文章时间">
  <span class="date-spine__year">{year}</span>
  <span class="date-spine__line" aria-hidden="true"></span>
  <span class="date-spine__month">{month}</span>
  <span class="date-spine__line" aria-hidden="true"></span>
  <strong class="date-spine__day">{day}</strong>
  <span class="date-spine__line" aria-hidden="true"></span>
  <span class="date-spine__label">AI<br />研究札记</span>
  <span class="date-spine__dots" aria-hidden="true"></span>
  <span class="date-spine__note">小实验，<br />大视野。</span>
</aside>
