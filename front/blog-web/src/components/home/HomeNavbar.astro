---
import { currentProfile } from "@/config/build-profile";
import HomeControls from "@/components/islands/HomeControls";
---

<header class="home-nav-wrap" transition:persist="home-navbar">
  <div class="home-nav">
    <a
      class="home-nav__brand"
      href="/"
      aria-label={`${currentProfile.site.title} 首页`}
    >
      <span class="home-nav__mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </span>
      <span class="home-nav__wordmark">AIMCC</span>
      <span class="home-nav__descriptor">AI 研究札记 / 实验研究日志</span>
    </a>
    <nav class="home-nav__links" aria-label="主导航">
      <a class="is-active" href="/">首页</a>
      <a href="/archive/">归档</a>
      <a href="/about/">关于</a>
    </nav>
    <div class="home-nav__status" aria-label="站点状态">
      <span class="home-nav__online"><i></i>在线</span>
      <time datetime={new Date().toISOString()}>
        {
          new Intl.DateTimeFormat("zh-CN", {
            year: "numeric",
            month: "short",
            day: "numeric",
          }).format(new Date())
        }
      </time>
    </div>
    <HomeControls client:load />
  </div>
</header>
