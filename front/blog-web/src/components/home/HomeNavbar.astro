---
import { currentProfile } from "@/config/build-profile";
import HomeControls from "@/components/islands/HomeControls";
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="home-nav-wrap" transition:persist="home-navbar">
  <div class="home-nav">
    <button
      class="home-nav__sidebar-button home-nav__icon-button"
      type="button"
      data-open-sidebar
      aria-haspopup="dialog"
      aria-controls="sidebar-drawer"
      aria-label="打开导航与个人信息">☰</button
    >
    <a
      class="home-nav__brand"
      href="/"
      aria-label={`${currentProfile.site.title} 首页`}
    >
      <span class="home-nav__mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </span>
      <span class="home-nav__wordmark">AIMCC</span>
      <span class="home-nav__descriptor">AI 研究札记 / 实验研究日志</span>
    </a>
    <nav class="home-nav__links" aria-label="主导航">
      <a
        class:list={{ "is-active": pathname === "/" }}
        aria-current={pathname === "/" ? "page" : undefined}
        href="/">首页</a
      >
      <a
        class:list={{ "is-active": pathname === "/archive" }}
        aria-current={pathname === "/archive" ? "page" : undefined}
        href="/archive/">归档</a
      >
    </nav>
    <div class="home-nav__status" aria-label="站点状态">
      <span class="home-nav__online"><i></i>在线</span>
      <time datetime={new Date().toISOString()}>
        {
          new Intl.DateTimeFormat("zh-CN", {
            year: "numeric",
            month: "short",
            day: "numeric",
          }).format(new Date())
        }
      </time>
    </div>
    <HomeControls client:load />
  </div>
</header>

<script>
  const syncCurrentPage = () => {
    const pathname = window.location.pathname.replace(/\/+$/, "") || "/";
    document
      .querySelectorAll<HTMLAnchorElement>(".home-nav__links a")
      .forEach((link) => {
        const current =
          (new URL(link.href).pathname.replace(/\/+$/, "") || "/") === pathname;
        link.classList.toggle("is-active", current);
        if (current) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
  };
  document.addEventListener("astro:page-load", syncCurrentPage);
  syncCurrentPage();
</script>
