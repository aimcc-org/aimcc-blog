---
import { currentProfile } from '@/config/build-profile';
---
<header style="border-bottom: 1px solid var(--color-border); background: var(--color-surface);">
  <div class="shell" style="height: 64px; display:flex; align-items:center; justify-content:space-between; gap:24px;">
    <a href="/" style="font-weight:700; text-decoration:none;">{currentProfile.site.title}</a>
    <nav style="display:flex; gap:18px; font-size:14px;">
      <a href="/">首页</a>
      <a href="/archive/">归档</a>
      <a href="/about/">关于</a>
    </nav>
  </div>
</header>
