---
import { render } from "astro:content";
import type { SiteContentEntry } from "@/content/posts";

interface Props {
  entry: SiteContentEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(entry.data.published);
const latinWords =
  entry.body?.match(/[A-Za-z0-9]+(?:[-'][A-Za-z0-9]+)*/g)?.length ?? 0;
const cjkChars = entry.body?.match(/[\u4e00-\u9fff]/g)?.length ?? 0;
const readingTime = Math.max(1, Math.ceil((latinWords + cjkChars) / 300));
const cover =
  (entry.data.image as { src?: string } | undefined)?.src ??
  "/images/ai-workflow-city.png";
---

<article class="post-article">
  <header class="post-article__hero">
    <div class="post-article__intro">
      <span class="eyebrow"><i></i> {entry.data.category || "研究札记"}</span>
      <h1>{entry.data.title}</h1>
      <div class="post-article__tags" aria-label="文章标签">
        {entry.data.tags.map((tag) => <span># {tag}</span>)}
      </div>
      {entry.data.description && <p>{entry.data.description}</p>}
      <a class="post-article__back" href="/#posts">← 返回文章列表</a>
    </div>

    <figure class="post-article__visual">
      <img src={cover} alt="未来研究城市与数据路径" fetchpriority="high" />
      <div class="post-article__stages" aria-hidden="true">
        <span>观察</span><span>构建</span><span>复盘</span>
      </div>
      <figcaption>智能协作系统 / 观察 · 构建 · 复盘</figcaption>
    </figure>
  </header>

  <div class="post-article__lower">
    <div class="post-article__body">
      <div class="prose"><Content /></div>
    </div>

    <aside class="post-article__meta" aria-label="文章信息">
      <div class="post-article__read-time">
        <span aria-hidden="true">◷</span>
        阅读约 {readingTime} 分钟
      </div>
      <dl>
        <div><dt>日期</dt><dd>{date}</dd></div>
        <div>
          <dt>主题</dt>
          <dd>
            {entry.data.tags.length ? entry.data.tags.join(" / ") : "未分类"}
          </dd>
        </div>
      </dl>
      <div class="post-article__progress-label">
        <span>阅读进度</span><strong data-reading-percent>0%</strong>
      </div>
      <div class="post-article__progress" aria-hidden="true">
        <i data-reading-progress></i>
      </div>
      <a href="/archive/">继续探索 <span aria-hidden="true">→</span></a>
      {
        entry.data.description && (
          <blockquote>“{entry.data.description}”</blockquote>
        )
      }
    </aside>
  </div>
</article>

<script>
  const updateReadingProgress = () => {
    const scrollRoot = document.querySelector<HTMLElement>(
      ".home-scroll-region",
    );
    const article = document.querySelector<HTMLElement>(".post-article");
    const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
    const label = document.querySelector<HTMLElement>("[data-reading-percent]");
    if (!scrollRoot || !article || !bar || !label) return;

    const start =
      article.getBoundingClientRect().top -
      scrollRoot.getBoundingClientRect().top +
      scrollRoot.scrollTop;
    const distance = Math.max(
      article.offsetHeight - scrollRoot.clientHeight,
      1,
    );
    const percent = Math.min(
      100,
      Math.max(0, ((scrollRoot.scrollTop - start) / distance) * 100),
    );
    bar.style.width = `${percent}%`;
    label.textContent = `${Math.round(percent)}%`;
  };

  const bindReadingProgress = () => {
    const scrollRoot = document.querySelector<HTMLElement>(
      ".home-scroll-region",
    );
    if (!scrollRoot) return;

    if (
      window.__aimccReadingProgressRoot &&
      window.__aimccReadingProgressHandler
    ) {
      window.__aimccReadingProgressRoot.removeEventListener(
        "scroll",
        window.__aimccReadingProgressHandler,
      );
    }
    window.__aimccReadingProgressHandler = updateReadingProgress;
    window.__aimccReadingProgressRoot = scrollRoot;
    scrollRoot.addEventListener("scroll", updateReadingProgress, {
      passive: true,
    });
    updateReadingProgress();
  };

  bindReadingProgress();
  document.addEventListener("astro:page-load", bindReadingProgress);
</script>
