---
import '@/styles/global.css';
import SiteHeader from '@/components/common/SiteHeader.astro';
import { currentProfile } from '@/config/build-profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = currentProfile.site.description } = Astro.props;
const pageTitle = title ? `${title} · ${currentProfile.site.title}` : currentProfile.site.title;
---
<!doctype html>
<html lang={currentProfile.site.lang} data-theme={currentProfile.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <slot />
  </body>
</html>
