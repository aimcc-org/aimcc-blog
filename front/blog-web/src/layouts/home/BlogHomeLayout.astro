---
import BaseLayout from "@/layouts/base/BaseLayout.astro";
import HomeNavbar from "@/components/home/HomeNavbar.astro";
import ArticleRail from "@/components/home/ArticleRail.astro";
import HomeFooter from "@/components/home/HomeFooter.astro";
import type { PostSummary } from "@/types/post";
import "@/styles/home.css";

interface Props {
  title?: string;
  description?: string;
  posts: PostSummary[];
  activeSlug?: string;
}

const { title, description, posts, activeSlug } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  showHeader={false}
  enableTransitions
>
  <div class="home-page">
    <HomeNavbar />
    <div class="home-workspace">
      <ArticleRail posts={posts} activeSlug={activeSlug} />
      <div class="home-scroll-region">
        <main class="editorial-shell" transition:animate="none">
          <div class="editorial-content"><slot /></div>
        </main>
        <HomeFooter />
      </div>
    </div>
  </div>
</BaseLayout>
