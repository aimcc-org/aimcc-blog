---
import BaseLayout from "@/layouts/base/BaseLayout.astro";
import HomeNavbar from "@/components/home/HomeNavbar.astro";
import ArticleRail from "@/components/home/ArticleRail.astro";
import HomeFooter from "@/components/home/HomeFooter.astro";
import HomeAside from "@/components/home/HomeAside.astro";
import type { PostSummary } from "@/types/post";
import "@/styles/home.css";
import "@/styles/responsive.css";

interface Props {
  title?: string;
  description?: string;
  posts: PostSummary[];
  activeSlug?: string;
}

const { title, description, posts, activeSlug } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  showHeader={false}
  enableTransitions
>
  <div class="home-page">
    <HomeNavbar />
    <div class="home-workspace">
      <ArticleRail posts={posts} activeSlug={activeSlug} />
      <div class="home-scroll-region">
        <main class="editorial-shell" transition:animate="none">
          <div class="editorial-content"><slot /></div>
        </main>
        <HomeFooter />
      </div>
      <HomeAside />
    </div>
    <dialog
      id="sidebar-drawer"
      class="sidebar-drawer"
      aria-labelledby="sidebar-drawer-title"
    >
      <ArticleRail posts={posts} activeSlug={activeSlug} drawer />
    </dialog>
  </div>
</BaseLayout>

<script>
  const currentSidebar = () =>
    document.querySelector<HTMLDialogElement>("#sidebar-drawer");
  // The navbar can persist while Astro replaces the page and its dialog.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const dialog = currentSidebar();
    if (!dialog) return;
    if (event.target.closest("[data-open-sidebar]")) {
      if (!dialog.open) dialog.showModal();
    } else if (
      event.target.closest("[data-close-sidebar]") ||
      event.target === dialog ||
      (dialog.open && event.target.closest("#sidebar-drawer a"))
    ) {
      dialog.close();
    }
  });
  const desktop = window.matchMedia("(min-width: 1200px)");
  desktop.addEventListener("change", () => {
    if (desktop.matches) currentSidebar()?.close();
  });
  document.addEventListener("astro:before-swap", () =>
    currentSidebar()?.close(),
  );
</script>
