---
import { currentProfile } from '@/config/build-profile';
import { getProfilePosts } from '@/core/content/posts';
import { layoutRegistry } from '@/registry/layouts';
import { postTemplateRegistry } from '@/registry/templates';

export async function getStaticPaths() {
  const posts = await getProfilePosts();
  return posts.map(({ entry, meta }) => ({
    params: { slug: meta.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const Layout = layoutRegistry[currentProfile.layouts.post];
const PostTemplate = postTemplateRegistry[currentProfile.templates.post];
---
<Layout title={entry.data.title} description={entry.data.description}>
  <PostTemplate entry={entry} />
</Layout>
