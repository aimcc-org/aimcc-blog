---
import { getProfilePosts } from "@/content/posts";
import { toPostSummary } from "@/types/post";
import BlogHomeLayout from "@/layouts/home/BlogHomeLayout.astro";
import HomeSidebar from "@/components/home/sidebar/HomeSidebar.astro";
import PostArticle from "@/components/posts/PostArticle.astro";

export async function getStaticPaths() {
  const profilePosts = await getProfilePosts();
  const posts = profilePosts.map(toPostSummary);
  return profilePosts.map(({ entry, meta }) => ({
    params: { slug: meta.slug },
    props: { entry, posts },
  }));
}

const { entry, posts } = Astro.props;
---

<BlogHomeLayout title={entry.data.title} description={entry.data.description}>
  <HomeSidebar posts={posts} />
  <section
    id="article"
    class="home-article"
    aria-label="文章正文"
    transition:name="home-content"
    transition:animate="slide"
  >
    <a class="home-article__back" href="/#posts" aria-label="返回文章列表"
      >← <span>返回文章列表</span></a
    >
    <PostArticle entry={entry} />
  </section>
</BlogHomeLayout>
