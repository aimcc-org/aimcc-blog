---
import type { SiteContentEntry } from '@/core/content/posts';
import { parseContentId } from '@/core/content/posts';
import { currentProfile } from '@/config/build-profile';
interface Props { posts: { entry: SiteContentEntry; meta: NonNullable<ReturnType<typeof parseContentId>> }[]; }
const { posts } = Astro.props;
---
<section style="padding: 32px 0 44px;">
  <p class="muted" style="margin:0 0 8px;">{currentProfile.site.description}</p>
  <h1 style="font-size:clamp(40px,8vw,78px); line-height:1; margin:0;">{currentProfile.site.title}</h1>
</section>
<div class="stack">
  {posts.map(({ entry, meta }) => (
    <article class="card" style="padding:24px;">
      <a href={`/posts/${meta.slug}/`} style="text-decoration:none;"><h2 style="margin-top:0;">{entry.data.title}</h2></a>
      <p class="muted">{entry.data.description}</p>
    </article>
  ))}
</div>
