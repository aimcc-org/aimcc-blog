---
import type { SiteContentEntry } from '@/core/content/posts';
import { parseContentId } from '@/core/content/posts';
interface Props { posts: { entry: SiteContentEntry; meta: NonNullable<ReturnType<typeof parseContentId>> }[]; }
const { posts } = Astro.props;
---
<h1>Archive</h1>
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;">
  {posts.map(({ entry, meta }) => (
    <article class="card" style="padding:20px;">
      <a href={`/posts/${meta.slug}/`}><strong>{entry.data.title}</strong></a>
      <p class="muted" style="font-size:13px;">{entry.data.published.toISOString().slice(0, 10)}</p>
    </article>
  ))}
</div>
