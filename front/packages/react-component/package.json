{
  "name": "@aimcc/react-component",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./markdown": "./src/MarkdownReader.tsx",
    "./markdown-editor": "./src/MarkdownEditor.tsx",
    "./markdown.css": "./src/markdown.css",
    "./markdown-editor.css": "./src/markdown-editor.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
